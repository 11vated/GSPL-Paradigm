{
  "name": "gspl-paradigm",
  "version": "1.0.0",
  "description": "GSPL Paradigm — The Living World Compiler",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "dev:web": "pnpm --filter @paradigm/web dev",
    "dev:desktop": "pnpm --filter @paradigm/desktop dev",
    "dev:tui": "pnpm --filter @paradigm/tui dev",
    "dev:cli": "pnpm --filter @paradigm/cli dev",
    "dev:studio": "pnpm --filter @paradigm/studio dev"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.4.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "@vitest/coverage-v8": "^3.0.0"
  }
}
